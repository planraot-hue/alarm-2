# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง

# ---------- Supabase ----------
# หาได้ที่ Supabase Dashboard → Project Settings → API
# anon key เปิดเผยได้ ความปลอดภัยจริงมาจาก RLS ในฐานข้อมูล
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------- Gemini (แชตบอต) ----------
# ขอคีย์ฟรีที่ https://aistudio.google.com/apikey
#
# สำคัญ: ห้ามเปลี่ยนชื่อเป็น NEXT_PUBLIC_GEMINI_API_KEY เด็ดขาด
# คีย์นี้เป็นความลับจริง ไม่เหมือน anon key ของ Supabase
# ถ้ามี NEXT_PUBLIC_ นำหน้า Next.js จะฝังลง bundle ให้ใครก็เห็นและเอาไปใช้จนโควตาหมดได้
GEMINI_API_KEY=AIza...

# ไม่ใส่ก็ได้ — ถ้าโมเดลที่ตั้งไว้ใช้ไม่ได้ ระบบจะหารายชื่อจาก Google แล้วเลือกให้เอง
GEMINI_MODEL=gemini-2.5-flash

# ---------- รูปพรีวิวตอนแชร์ลิงก์ (LINE / Facebook) ----------
# ไม่ต้องใส่ถ้า deploy บน Vercel — ระบบอ่านโดเมนจาก VERCEL_PROJECT_PRODUCTION_URL เอง
# ใส่เมื่อใช้โดเมนของตัวเอง เช่น https://planner.example.com
# ต้องเป็น URL เต็มขึ้นต้นด้วย https:// ไม่งั้น LINE จะไม่แสดงรูป
# NEXT_PUBLIC_SITE_URL=https://alarm-2.vercel.app
